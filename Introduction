<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Introduction aux Systèmes de Recommandation</title>
<style>
  :root {
    --primary: #4f46e5;
    --primary-dark: #3730a3;
    --primary-light: #818cf8;
    --accent: #f59e0b;
    --accent-light: #fbbf24;
    --danger: #ef4444;
    --success: #10b981;
    --bg: #f8fafc;
    --bg-alt: #f1f5f9;
    --surface: #ffffff;
    --text: #0f172a;
    --text-muted: #64748b;
    --border: #e2e8f0;
    --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
    --shadow-md: 0 4px 12px rgba(0,0,0,0.08);
    --shadow-lg: 0 12px 32px rgba(0,0,0,0.12);
    --radius: 14px;
    --radius-lg: 22px;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  html { scroll-behavior: smooth; }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Inter', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    line-height: 1.7;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }

  /* ================= HERO ================= */
  .hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1e1b4b 0%, #4f46e5 50%, #7c3aed 100%);
    color: white;
    overflow: hidden;
    padding: 4rem 1.5rem;
    text-align: center;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(circle at 20% 30%, rgba(255,255,255,0.12) 0%, transparent 40%),
      radial-gradient(circle at 80% 70%, rgba(245,158,11,0.18) 0%, transparent 45%),
      radial-gradient(circle at 50% 50%, rgba(129,140,248,0.15) 0%, transparent 60%);
    animation: floatBg 18s ease-in-out infinite alternate;
  }

  @keyframes floatBg {
    0%   { transform: scale(1) rotate(0deg); }
    100% { transform: scale(1.15) rotate(3deg); }
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 900px;
    animation: fadeUp 1s ease-out;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.5rem 1.2rem;
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 50px;
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-bottom: 1.8rem;
    backdrop-filter: blur(10px);
  }

  .hero h1 {
    font-size: clamp(2.2rem, 5.5vw, 4rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.02em;
  }

  .hero h1 .gradient-text {
    background: linear-gradient(90deg, #fbbf24, #f472b6);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: clamp(1rem, 2vw, 1.3rem);
    opacity: 0.92;
    max-width: 700px;
    margin: 0 auto 2.5rem;
    font-weight: 300;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
    flex-wrap: wrap;
    margin-top: 3rem;
  }

  .hero-stat {
    text-align: center;
  }

  .hero-stat-number {
    font-size: 2.2rem;
    font-weight: 800;
    background: linear-gradient(90deg, #fff, #fbbf24);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    display: block;
  }

  .hero-stat-label {
    font-size: 0.85rem;
    opacity: 0.8;
    letter-spacing: 0.03em;
  }

  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ================= NAV ================= */
  .topnav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    padding: 0.8rem 1.5rem;
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    transition: box-shadow 0.3s;
  }

  .topnav a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.45rem 0.9rem;
    border-radius: 8px;
    transition: all 0.2s;
  }

  .topnav a:hover {
    color: var(--primary);
    background: var(--bg-alt);
  }

  /* ================= LAYOUT ================= */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  section {
    padding: 5rem 0;
  }

  section:nth-child(even) {
    background: var(--bg-alt);
  }

  .section-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .section-header .eyebrow {
    display: inline-block;
    color: var(--primary);
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    margin-bottom: 0.8rem;
  }

  .section-header h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin-bottom: 0.8rem;
  }

  .section-header p {
    color: var(--text-muted);
    max-width: 720px;
    margin: 0 auto;
    font-size: 1.05rem;
  }

  /* ================= REVEAL ================= */
  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.7s ease, transform 0.7s ease;
  }

  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* ================= CARDS ================= */
  .cards-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .card {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.8rem;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-sm);
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    top: 0; left: 0;
    height: 4px;
    width: 0;
    background: linear-gradient(90deg, var(--primary), var(--accent));
    transition: width 0.4s ease;
  }

  .card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }

  .card:hover::before {
    width: 100%;
  }

  .card-icon {
    font-size: 2.2rem;
    margin-bottom: 0.8rem;
    display: block;
  }

  .card h3 {
    font-size: 1.15rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--text);
  }

  .card p {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .card .examples {
    margin-top: 1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    background: var(--bg-alt);
    color: var(--primary-dark);
    border-radius: 50px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  /* ================= TABS ================= */
  .tabs {
    background: var(--surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    overflow: hidden;
    border: 1px solid var(--border);
  }

  .tab-nav {
    display: flex;
    background: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    overflow-x: auto;
  }

  .tab-btn {
    flex: 1;
    min-width: 140px;
    padding: 1.1rem 1rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.2s;
    border-bottom: 3px solid transparent;
    font-family: inherit;
  }

  .tab-btn:hover {
    color: var(--primary);
    background: rgba(79,70,229,0.05);
  }

  .tab-btn.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
    background: var(--surface);
  }

  .tab-panel {
    padding: 2.5rem;
    display: none;
    animation: fadeIn 0.4s ease;
  }

  .tab-panel.active { display: block; }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  /* ================= ACCORDION ================= */
  .accordion {
    max-width: 900px;
    margin: 0 auto;
  }

  .acc-item {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    margin-bottom: 1rem;
    overflow: hidden;
    transition: box-shadow 0.3s;
  }

  .acc-item:hover {
    box-shadow: var(--shadow-md);
  }

  .acc-header {
    padding: 1.3rem 1.5rem;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 1.02rem;
    user-select: none;
    transition: background 0.2s;
  }

  .acc-header:hover {
    background: var(--bg-alt);
  }

  .acc-icon {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--primary);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    flex-shrink: 0;
    transition: transform 0.3s;
  }

  .acc-item.open .acc-icon {
    transform: rotate(45deg);
  }

  .acc-body {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease, padding 0.4s ease;
    padding: 0 1.5rem;
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .acc-item.open .acc-body {
    max-height: 500px;
    padding: 0 1.5rem 1.4rem;
  }

  /* ================= FORMULA ================= */
  .formula-box {
    background: linear-gradient(135deg, #1e1b4b, #4f46e5);
    color: white;
    padding: 2rem;
    border-radius: var(--radius);
    font-family: 'Cambria Math', 'Latin Modern Math', Georgia, serif;
    text-align: center;
    font-size: 1.15rem;
    margin: 1.5rem 0;
    box-shadow: var(--shadow-md);
    letter-spacing: 0.02em;
    overflow-x: auto;
  }

  .formula-inline {
    background: var(--bg-alt);
    padding: 0.15rem 0.5rem;
    border-radius: 6px;
    font-family: 'Cambria Math', Georgia, serif;
    color: var(--primary-dark);
    font-weight: 600;
  }

  /* ================= MATRIX VIZ ================= */
  .matrix-viz {
    display: flex;
    justify-content: center;
    margin: 2rem 0;
    overflow-x: auto;
  }

  .matrix {
    border-collapse: separate;
    border-spacing: 4px;
    font-size: 0.8rem;
  }

  .matrix td {
    width: 38px;
    height: 38px;
    text-align: center;
    border-radius: 8px;
    background: var(--bg-alt);
    font-weight: 600;
    color: var(--text-muted);
    transition: all 0.3s;
  }

  .matrix td:hover {
    transform: scale(1.12);
    z-index: 2;
    position: relative;
  }

  .matrix .header {
    background: transparent;
    color: var(--primary);
    font-weight: 700;
  }

  .matrix .filled { color: white; }
  .matrix .v1 { background: #c7d2fe; }
  .matrix .v2 { background: #a5b4fc; }
  .matrix .v3 { background: #818cf8; }
  .matrix .v4 { background: #6366f1; }
  .matrix .v5 { background: #4f46e5; color: white; }
  .matrix .empty { background: #f1f5f9; color: #cbd5e1; }

  /* ================= CHALLENGES ================= */
  .challenge-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.2rem;
  }

  .challenge {
    background: var(--surface);
    border-radius: var(--radius);
    padding: 1.5rem;
    border-left: 5px solid var(--primary);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s;
  }

  .challenge:hover {
    transform: translateX(6px);
    box-shadow: var(--shadow-md);
  }

  .challenge.warn { border-left-color: var(--accent); }
  .challenge.danger { border-left-color: var(--danger); }
  .challenge.success { border-left-color: var(--success); }

  .challenge h4 {
    font-size: 1rem;
    font-weight: 700;
    margin-bottom: 0.4rem;
    color: var(--text);
  }

  .challenge p {
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  /* ================= TP BOX ================= */
  .tp-box {
    background: linear-gradient(135deg, #fff7ed, #ffedd5);
    border: 2px dashed var(--accent);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    margin-top: 2rem;
    position: relative;
  }

  .tp-badge {
    position: absolute;
    top: -18px;
    left: 2rem;
    background: var(--accent);
    color: white;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.05em;
    box-shadow: var(--shadow-md);
  }

  .tp-box h3 {
    margin-bottom: 1rem;
    font-size: 1.4rem;
    color: #92400e;
  }

  .tp-box ol {
    padding-left: 1.3rem;
    color: #78350f;
  }

  .tp-box ol li {
    margin-bottom: 0.6rem;
    font-size: 0.96rem;
  }

  .tp-box code {
    background: rgba(146,64,14,0.12);
    padding: 0.1rem 0.45rem;
    border-radius: 5px;
    font-family: 'Fira Code', monospace;
    font-size: 0.88rem;
    color: #7c2d12;
  }

  /* ================= QUOTE ================= */
  .quote {
    background: var(--surface);
    border-left: 4px solid var(--primary);
    padding: 1.5rem 2rem;
    margin: 2rem 0;
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    color: var(--text-muted);
    font-size: 1.05rem;
    box-shadow: var(--shadow-sm);
  }

  .quote-author {
    display: block;
    margin-top: 0.8rem;
    font-style: normal;
    font-weight: 600;
    color: var(--primary);
    font-size: 0.9rem;
  }

  /* ================= PIPELINE ================= */
  .pipeline {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 2rem 0;
  }

  .pipeline-step {
    background: var(--surface);
    border: 2px solid var(--primary-light);
    padding: 0.9rem 1.2rem;
    border-radius: var(--radius);
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--primary-dark);
    box-shadow: var(--shadow-sm);
    transition: all 0.3s;
  }

  .pipeline-step:hover {
    background: var(--primary);
    color: white;
    transform: scale(1.05);
    border-color: var(--primary);
  }

  .pipeline-arrow {
    color: var(--primary);
    font-size: 1.4rem;
    font-weight: 700;
  }

  /* ================= FOOTER ================= */
  footer {
    background: #0f172a;
    color: #94a3b8;
    padding: 3rem 1.5rem;
    text-align: center;
    font-size: 0.9rem;
  }

  footer strong {
    color: white;
  }

  /* ================= RESPONSIVE ================= */
  @media (max-width: 640px) {
    .hero-stats { gap: 1.5rem; }
    .hero-stat-number { font-size: 1.6rem; }
    .tab-panel { padding: 1.5rem; }
    .tab-btn { font-size: 0.82rem; padding: 0.9rem 0.6rem; }
    section { padding: 3.5rem 0; }
  }

  /* ================= SCROLLBAR ================= */
  ::-webkit-scrollbar { width: 10px; height: 10px; }
  ::-webkit-scrollbar-track { background: var(--bg-alt); }
  ::-webkit-scrollbar-thumb {
    background: var(--primary-light);
    border-radius: 5px;
  }
  ::-webkit-scrollbar-thumb:hover { background: var(--primary); }
</style>
</head>
<body>

<!-- ================= HERO ================= -->
<header class="hero">
  <div class="hero-content">
    <span class="hero-badge">Chapitre 1 · Introduction</span>
    <h1>Systèmes de <span class="gradient-text">Recommandation</span></h1>
    <p class="hero-subtitle">
